# ─── General ───────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ─── Database ──────────────────────────────────────────
DATABASE_URL=postgresql://hermes_app:CHANGE_ME@localhost:5432/hermes
POSTGRES_ROOT_PASSWORD=CHANGE_ME_ROOT
PG_APP_PASSWORD=CHANGE_ME_APP
PG_RETENTION_PASSWORD=CHANGE_ME_RETENTION

# ─── AWS Bedrock ───────────────────────────────────────
AWS_REGION=sa-east-1
BEDROCK_REGION=sa-east-1
BEDROCK_MODEL_ID=anthropic.claude-haiku-4-5:0
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME

# ─── SFCC ──────────────────────────────────────────────
SFCC_MODE=mock                    # "mock" para desarrollo, "real" para integración
SFCC_BASE_URL=https://CHANGE_ME.dx.commercecloud.salesforce.com
SFCC_CLIENT_ID=CHANGE_ME
SFCC_CLIENT_SECRET=CHANGE_ME

# ─── Security ──────────────────────────────────────────
PII_SALT=CHANGE_ME_debe_tener_al_menos_32_caracteres
ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_IP_MAX=30
RATE_LIMIT_CONV_MAX=10
JWT_SECRET=CHANGE_ME

# ─── Notifications (optional) ──────────────────────────
SLACK_WEBHOOK_URL=

# ─── Mail (handoff Unit 3) ─────────────────────────────
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=hermes@patprimo.local
