{
  "name": "hermes",
  "version": "0.1.0",
  "private": true,
  "description": "Agente conversacional de IA para atención al cliente sobre SFCC PASH SAS",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && npm run build:widget",
    "build:widget": "node widget/esbuild.config.mjs",
    "start": "node dist/server.js",
    "up": "docker compose up -d",
    "down": "docker compose down",
    "logs": "docker compose logs -f hermes",
    "rebuild": "docker compose build --no-cache hermes",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "create-bm": "tsx scripts/create-bm.ts",
    "backup": "tsx scripts/backup.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:pbt": "vitest run tests/pbt",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "smoke:caso1": "tsx scripts/smoke-caso1.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "0.12.0",
    "@fastify/compress": "7.0.3",
    "@fastify/cors": "9.0.1",
    "@fastify/helmet": "11.1.1",
    "@fastify/rate-limit": "9.1.0",
    "@fastify/static": "^7.0.4",
    "fastify": "4.28.1",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "1.2.0",
    "node-cron": "3.0.3",
    "pg": "8.12.0",
    "pino": "9.5.0",
    "postgres-migrations": "5.3.0",
    "undici": "6.21.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "autocannon": "^7.15.0",
    "esbuild": "^0.24.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "fast-check": "^3.22.0",
    "pino-pretty": "^11.3.0",
    "prettier": "^3.3.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
